# Copy to .env.local and fill in.

# n8n "Webhook" trigger URL that receives lead form submissions (use the Production URL).
# If unset: in development leads are logged to the console; in production the API returns 503.
N8N_LEAD_WEBHOOK_URL=

# Public URL of the site, without a trailing slash. Used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
